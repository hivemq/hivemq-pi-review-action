{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
        'local>hivemq/renovate-config:default.json5',
    ],
    baseBranchPatterns: [
        'main',
    ],
    useBaseBranchConfig: 'merge',
    branchPrefix: 'renovate/hivemq-pi-review-action/',
    addLabels: [
        'engineering-platform-team',
    ],
    // pi is installed inline by the workflow; pinned so an upstream catalog
    // change reaches consumers only through a tested PR.
    customManagers: [
        {
            customType: 'regex',
            managerFilePatterns: ['/^\\.github/workflows/pi-pr-review\\.yml$/'],
            matchStrings: ['npm install (?<depName>@earendil-works/pi-coding-agent)@(?<currentValue>[0-9.]+)'],
            datasourceTemplate: 'npm',
        },
    ],
}
